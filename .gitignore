# --- macOS ---
.DS_Store

# --- self-contained runtime (created on first launch) ---
.venv/
.python/
.cache/
__pycache__/
*.pyc

# --- third-party binaries and models: downloaded by `./animeup setup` ---
bin/

# --- user data: the folders ship empty ---
INPUT/*
OUTPUT/*
!INPUT/.gitkeep
!OUTPUT/.gitkeep
records/
cache/
# before 1.6
JOBS/
anteprime/
registri/

# --- synthetic test samples: generated by tests/fixtures.py ---
tests/.fixtures/

# --- local working material ---
_WIP/
Screenshots/
RIPRENDI_QUI.md

# --- app build output (tools/build_app.sh) ---
dist/
.migration.lock
